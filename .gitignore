/target
*.pdb
*.so
*.dylib
# Cargo.lock 是**入库**的：本 crate 交付 `treedb-server` 这个要部署的
# 二进制，可复现构建比“库依赖不读锁文件”这条惯例更值钱。
# PG 连接成本对照用的私有集群
/.pgref
# 吞吐矩阵与诊断用临时数据目录
/.matrix
/.diag
/.spot

# 双档全量回归的原始输出（文档里的 passed 计数只从这里取）
/.migtest

# 服务端 CPU 探针（benches/probe_srv.sh）的临时数据目录
/.probe

# 万级视图形状（benches/many_views.sh）的临时数据目录
/.manyviews

# git commit -F 用的提交消息草稿
/.cmsg*.txt

# 活体验证的临时数据目录（问题清单 F1/F3/F5 的往返）与连接/编译探针
/.live
/.connprobe
/.sqlbuild.log

# Python 检查器（benches/doc_table_check.py）跑一次就生成的字节码缓存
__pycache__/

# grovefs_pin_ab.sh 的隔离构建目录（旧 pin 的引擎二进制）
/.pinab
